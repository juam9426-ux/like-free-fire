// proxy.js (Node + Express minimal)
const express = require('express');
const fetch = require('node-fetch');
const app = express();
const PORT = 3000;

app.get('/api/info-player', async (req, res) => {
  const uid = req.query.uid;
  if (!uid) return res.status(400).send('uid required');

  const auth = process.env.API_AUTH || ''; // guarda tu auth en .env
  const url = `https://7xhub-api.squareweb.app/api/ff/info-player?uid=${encodeURIComponent(uid)}&auth=${encodeURIComponent(auth)}`;

  try {
    const r = await fetch(url);
    const json = await r.json();
    res.json(json);
  } catch (e) {
    res.status(500).send(e.message);
  }
});

app.listen(PORT, () => console.log('Proxy listening on http://localhost:'+PORT));
